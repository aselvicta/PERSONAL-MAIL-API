# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a placeholder.

# --- Application -----------------------------------------------------------
APP_NAME=Personal Mail API
# development | test | production
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# Serve Swagger UI at /docs and ReDoc at /redoc
DOCS_ENABLED=true
# Built-in admin page at /admin (sign in and manage projects in the browser).
ADMIN_UI_ENABLED=true

# --- Database --------------------------------------------------------------
# Local development (docker compose up -d db):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/personal_mail
# Supabase session pooler (recommended for Render; IPv4-compatible):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase direct connection (IPv6 unless you have the IPv4 add-on):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# libpq sslmode. When empty: "require" in production, driver default otherwise.
DATABASE_SSL_MODE=
# true when using Supabase's transaction pooler (port 6543). Auto-detected when empty.
DATABASE_TRANSACTION_POOLER=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# --- Resend ----------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_TIMEOUT_SECONDS=10
# Signing secret (whsec_...) from Resend > Webhooks
RESEND_WEBHOOK_SECRET=
# Must be an address on a domain verified in Resend.
# For a quick test without a domain, Resend allows onboarding@resend.dev
# (it can only deliver to your own Resend account email).
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
DEFAULT_FROM_NAME=Personal Mail API
# Comma-separated domains projects may use as sender_email (all must be verified
# in Resend). Empty = only the DEFAULT_FROM_EMAIL domain.
ALLOWED_SENDER_DOMAINS=

# --- Administrator authentication ------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional: administrator created/updated automatically at container start
# (useful on hosts without a shell, e.g. Render free). Min 12 characters.
# Changing ADMIN_PASSWORD and restarting updates the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- HTTP / abuse protection -----------------------------------------------
# Comma-separated browser origins allowed by CORS, e.g. https://example.com,https://app.example.com
CORS_ORIGINS=
# Cloudflare Turnstile secret for public contact forms (optional)
TURNSTILE_SECRET_KEY=
RATE_LIMIT_ENABLED=true
# Contact form submissions per client IP, per project, per hour
CONTACT_RATE_LIMIT_PER_IP=5
# Admin login attempts per client IP (and per email) per 15 minutes
LOGIN_RATE_LIMIT_PER_IP=10
MAX_REQUEST_BODY_BYTES=524288
# Reverse proxies in front of the app that append to X-Forwarded-For.
# 0 locally; 1 on Render; 2 on Render behind Cloudflare.
TRUSTED_PROXY_COUNT=0
WEBHOOK_TOLERANCE_SECONDS=300

# --- Process (Docker / Render) ---------------------------------------------
# Run `alembic upgrade head` in scripts/start.sh before starting the server
RUN_MIGRATIONS=true
WEB_CONCURRENCY=2
